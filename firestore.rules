rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection: Users can read their own profile, but CANNOT write (backend only)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; 
    }
    
    // Transactions collection: Users can read if they are sender or receiver, NO writes
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow write: if false; 
    }
    
    // Fallback: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
